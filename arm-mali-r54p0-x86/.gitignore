# External driver input
downloads/*.tar
downloads/*.tar.*
# Signed upstream manifests are re-fetchable external input; their URL, signing
# key, and validated digest are recorded in research/versions.md instead.
downloads/*.asc
downloads/*.sign

# Python bytecode
__pycache__/
*.pyc

# Generated build/source trees
source/*
!source/README.md
kernel/*
rootfs/*
artifacts/*
qemu/logs/*
fuzz/syzkaller/*
fuzz/corpus/*
fuzz/programs/*
fuzz/crashes/*
work/*

# Runtime logs/state
logs/*.log
logs/*.txt
research/state.log

# Editor/OS
.vscode/
.idea/
*.swp
.DS_Store

# Source archives
*.tar.gz
*.tar.xz
*.tgz
downloads/*.zip

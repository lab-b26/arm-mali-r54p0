# External driver input
downloads/*.tar
downloads/*.tar.*
# Signed upstream manifests are re-fetchable external input; their URL, signing
# key, and validated digest are recorded in research/versions.md instead.
downloads/*.asc
downloads/*.sign

# Python bytecode
__pycache__/
*.pyc

# Third-party checkouts cloned at run time (re-fetchable external input).
# libGPUCounters is Arm's own repo from https://github.com/ARM-software/libGPUCounters.git;
# its URL, branch and exact HEAD are recorded in research/decisions.md and
# logs/libgpuCounters-6.12.111.txt. Ignoring the directory is deliberate: committing it
# as a gitlink would record only a commit SHA and none of its content, and committing
# its files would vendor someone else's repository into this one.
fuzz/libGPUCounters/

# Generated build/source trees
source/*
!source/README.md
kernel/*
rootfs/*
artifacts/*
qemu/logs/*
fuzz/syzkaller/*
fuzz/corpus/*
fuzz/programs/*
fuzz/crashes/*
work/*

# Runtime logs/state
logs/*.log
logs/*.txt
research/state.log

# Editor/OS
.vscode/
.idea/
*.swp
.DS_Store

# Source archives
*.tar.gz
*.tar.xz
*.tgz
downloads/*.zip
